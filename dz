import torch

print("=== 1.1 Создание тензоров ===")
# Случайные числа от 0 до 1, форма 3x4
t_rand = torch.rand(3, 4)

# Тензор из нулей 2x3x4
t_zeros = torch.zeros(2, 3, 4)

# Тензор из единиц 5x5
t_ones = torch.ones(5, 5)

# Числа от 0 до 15 с reshape в форму 4x4
t_range = torch.arange(16).reshape(4, 4)

print("t_rand:\n", t_rand)
print("t_range:\n", t_range)


print("\n=== 1.2 Операции над тензорами ===")
A = torch.randn(3, 4)
B = torch.randn(4, 3)

# Транспонирование A (3x4 -> 4x3)
A_T = A.T  # или A.transpose(0, 1)

# Матричное умножение (3x4 @ 4x3 -> 3x3)
matmul_res = torch.matmul(A, B)  # или A @ B

# Поэлементное умножение A и транспонированного B (обе 3x4)
elem_mul = A * B.T

# Сумма всех элементов
sum_all = A.sum()

print("Matmul A @ B:\n", matmul_res)
print("Сумма элементов A:", sum_all.item())


print("\n=== 1.3 Индексация и срезы ===")
# Тензор 5x5x5
t_3d = torch.arange(125).reshape(5, 5, 5)

# Первая «строка» (первая строка первой плоскости / срез)
first_row = t_3d[0, 0, :]

# Последний столбец (в первой плоскости)
last_col = t_3d[0, :, -1]

# Подматрица 2x2 из центра тензора (по индексам 2:4)
center_2x2 = t_3d[2, 1:3, 1:3]

# Элементы с четными индексами (шаг 2)
even_elements = t_3d[::2, ::2, ::2]

print("Center 2x2:\n", center_2x2)


print("\n=== 1.4 Изменение форм (Reshape) ===")
flat_tensor = torch.arange(24)

shapes = [(2, 12), (3, 8), (4, 6), (2, 3, 4), (2, 2, 2, 3)]
for s in shapes:
    reshaped = flat_tensor.reshape(s)
    print(f"Форма {s}: размер {reshaped.shape}")
